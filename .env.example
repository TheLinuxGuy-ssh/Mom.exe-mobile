# Expo inlines every EXPO_PUBLIC_* value into the app bundle at build time, so treat this file as
# public — never put a secret here. Copy to `.env` and fill in.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_NIM_MODEL=openai/gpt-oss-20b # Best OSS with which the app is recommended

# Server-side secret: the app never reads this, the Supabase edge function does.
#   supabase secrets set NIM_API_KEY=nvapi-...
#   supabase functions deploy plan
NIM_API_KEY=
